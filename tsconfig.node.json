{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "./.artifacts/typecheck/node.tsbuildinfo"
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*",
		"packages/agent/examples/**/*",
		"packages/durable/test-workers/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/web/src/**",
		"packages/web/test/**"
	]
}
