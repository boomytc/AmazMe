{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "./.artifacts/typecheck/node.tsbuildinfo"
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*",
		"packages/agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/coding-agent/examples/extensions/gondolin/**",
		"packages/web/src/**",
		"packages/web/test/**",
		"packages/coding-agent/src/host/web/page.ts",
		"packages/coding-agent/test/experimental-web-transitions.test.ts"
	]
}
