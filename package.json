{
	"name": "amazme",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build --workspace @amazme/tui && npm run build --workspace @amazme/codemode && npm run build --workspace @amazme/web && npm run build --workspace @amazme/coding-agent && npm run build --workspace @amazme/gui",
		"build:offline": "npm run build --workspace @amazme/tui && npm run build --workspace @amazme/codemode && npm run build --workspace @amazme/web && npm run build --workspace @amazme/coding-agent && npm run build --workspace @amazme/gui",
		"build:native:darwin": "npm --prefix packages/tui run build:native:darwin",
		"build:native:linux": "npm --prefix packages/tui run build:native:linux",
		"build:native:win32": "npm --prefix packages/tui run build:native:win32",
		"dev:tui": "node --import ./packages/coding-agent/src/source-resolver.ts ./packages/coding-agent/src/cli.ts",
		"dev:web": "node scripts/dev-web.mjs",
		"dev:desktop": "node scripts/build-workspace-dependencies.mjs @amazme/gui && npm start --workspace @amazme/gui",
		"check:model-data": "backend/.venv/bin/python -m pytest backend/tests/test_model_catalog.py backend/tests/test_thinking.py -q",
		"test:engineering": "node --test scripts/*.test.mjs",
		"typecheck": "tsc -b tsconfig.json --pretty false",
		"check:workspace": "node scripts/check-workspace.mjs",
		"release": "node scripts/release.mjs",
		"eval": "npm run eval --workspace=@amazme/evals --",
		"test": "npm run test --workspaces --if-present",
		"test:mcp-conformance": "backend/.venv/bin/python -m pytest backend/tests/test_mcp.py backend/tests/test_mcp_model.py backend/tests/test_native_mcp.py",
		"sync:pi-models": "backend/.venv/bin/python backend/tools/sync_pi_models.py"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"shx": "0.3.4",
		"typescript": "7.0.2",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.3.4",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
