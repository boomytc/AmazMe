{
	"name": "amazme",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build --workspace @amazme/codemode && npm run build --workspace @amazme/web && npm run build --workspace @amazme/gui",
		"dev:web": "node scripts/dev-web.mjs",
		"dev:desktop": "node scripts/dev-desktop.mjs",
		"typecheck": "tsc -b tsconfig.json --pretty false",
		"check:workspace": "node scripts/check-workspace.mjs",
		"eval": "npm run eval --workspace=@amazme/evals --",
		"sync:pi-models": "backend/.venv/bin/python backend/tools/sync_pi_models.py",
		"sync:command-code-models": "backend/.venv/bin/python backend/tools/sync_command_code_models.py"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.1.0",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
