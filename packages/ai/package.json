{
  "name": "@amazme/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified LLM API: providers, auth, message model, and stream events",
  "dependencies": {
    "@amazme/telemetry": "0.1.0",
    "typebox": "1.3.27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./api/openai-completions": {
      "types": "./dist/api/openai-completions.d.ts",
      "default": "./src/api/openai-completions.ts"
    },
    "./providers/completions": {
      "types": "./dist/providers/completions.d.ts",
      "default": "./src/providers/completions.ts"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "default": "./src/providers/openai.ts"
    },
    "./providers/faux": {
      "types": "./dist/providers/faux.d.ts",
      "default": "./src/providers/faux.ts"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "default": "./src/api/*.ts"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "default": "./src/providers/*.ts"
    },
    "./auth/oauth/flows": {
      "types": "./dist/auth/oauth/flows.d.ts",
      "default": "./src/auth/oauth/flows.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
