{
	"name": "@amazme/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"description": "AmazMe desktop and web client presentation for the Python backend",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./assets": {
			"types": "./dist/assets.d.ts",
			"import": "./dist/assets.js"
		},
		"./locale": {
			"types": "./dist/locale.d.ts",
			"import": "./dist/locale.js"
		},
		"./strings": {
			"types": "./dist/strings.d.ts",
			"import": "./dist/strings.js"
		},
		"./typography": {
			"types": "./dist/typography.d.ts",
			"import": "./dist/typography.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"import": "./dist/errors.js"
		}
	},
	"scripts": {
		"clean": "node ../../scripts/locked-workspace-task.mjs @amazme/web clean",
		"clean:unlocked": "python3 ../../backend/tools/workspace_lock.py --require && node ../../scripts/package-files.mjs clean dist",
		"build": "node ../../scripts/locked-workspace-task.mjs @amazme/web build",
		"build:unlocked": "python3 ../../backend/tools/workspace_lock.py --require && npm run clean:unlocked && tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs copy src/page dist && node build-page.mjs",
		"typecheck": "tsc -p tsconfig.build.json --noEmit"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"lucide-react": "1.66.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	}
}
