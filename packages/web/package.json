{
	"name": "@amazme/web",
	"version": "0.3.4",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"description": "AmazMe desktop and web client presentation for the Python backend",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./assets": {
			"types": "./dist/assets.d.ts",
			"import": "./dist/assets.js"
		},
		"./locale": {
			"types": "./dist/locale.d.ts",
			"import": "./dist/locale.js"
		},
		"./strings": {
			"types": "./dist/strings.d.ts",
			"import": "./dist/strings.js"
		},
		"./typography": {
			"types": "./dist/typography.d.ts",
			"import": "./dist/typography.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run clean && tsc -p tsconfig.build.json && shx cp -r src/page dist/page && node build-page.mjs",
		"test": "vitest --run",
		"typecheck": "tsc -p tsconfig.test.json"
	},
	"devDependencies": {
		"happy-dom": "20.10.5",
		"shx": "0.3.4",
		"vitest": "4.1.12"
	}
}
