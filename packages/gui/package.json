{
	"name": "@amazme/gui",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Electron window that loads the existing AmazMe web host",
	"main": "./dist/main.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && shx cp src/preload.cjs src/update-preload.cjs src/update-window.html src/update-window.js dist/ && node ../../scripts/build-update-helper.mjs",
		"start": "node dist/start.js",
		"test": "vitest --run --exclude test/smoke.test.ts --exclude test/desktop-lifecycle.smoke.test.ts --exclude test/update-window.smoke.test.ts",
		"test:smoke": "vitest --run --no-file-parallelism test/smoke.test.ts test/desktop-lifecycle.smoke.test.ts test/update-window.smoke.test.ts",
		"typecheck": "tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"@amazme/web": "0.3.0",
		"@amazme/coding-agent": "0.3.0"
	},
	"devDependencies": {
		"electron": "44.6.0",
		"shx": "0.3.4",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist",
		"assets",
		"README.md"
	]
}
