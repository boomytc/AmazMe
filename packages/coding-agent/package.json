{
	"name": "@amazme/coding-agent",
	"version": "0.1.0",
	"description": "CLI and terminal client for the AmazMe Python backend",
	"type": "module",
	"amazmeConfig": {
		"name": "AmazMe",
		"configDir": ".amazme"
	},
	"bin": {
		"amazme": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./update-manifest": {
			"source": "./src/update-manifest.ts",
			"types": "./dist/update-manifest.d.ts",
			"import": "./dist/update-manifest.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./config": {
			"source": "./src/config.ts",
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"schemas",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run clean && npm run build:unbundled && node ../../scripts/build-coding-agent-bundle.mjs",
		"build:unbundled": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js dist/rpc-entry.js && npm run copy-assets",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/",
		"test": "vitest --run",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@amazme/tui": "0.1.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "6.0.0",
		"highlight.js": "10.7.3",
		"semver": "7.8.5",
		"typebox": "1.3.27"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"shx": "0.3.4",
		"vitest": "4.1.12"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
