{
	"name": "@amazme/coding-agent",
	"version": "0.1.0",
	"description": "CLI client for the AmazMe Python backend",
	"type": "module",
	"amazmeConfig": {
		"name": "AmazMe",
		"configDir": ".amazme"
	},
	"bin": {
		"amazme": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./config": {
			"source": "./src/config.ts",
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "npm run clean && npm run build:unbundled && node ../../scripts/build-coding-agent-bundle.mjs",
		"build:unbundled": "tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs executable dist/cli.js dist/rpc-entry.js"
	},
	"dependencies": {
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "6.0.0",
		"typebox": "1.3.27"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@types/node": "22.19.19"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"private": true
}
