{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@amazme/chord": ["../chord/dist/index.d.ts"],
			"@amazme/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@amazme/chord/node": ["../chord/dist/node.d.ts"],
			"@amazme/agent": ["../agent/dist/index.d.ts"],
			"@amazme/agent/*": ["../agent/dist/*.d.ts"],
			"@amazme/ai": ["../ai/dist/index.d.ts"],
			"@amazme/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@amazme/durable": ["../durable/dist/index.d.ts"],
			"@amazme/durable/*": ["../durable/dist/*.d.ts", "../durable/dist/*"],
			"@amazme/tui": ["../tui/dist/index.d.ts"],
			"@amazme/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/client", "src/experimental", "src/cli/experimental"]
}
