{
  "name": "@amazme/runtime-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Durable runtime control and complete-snapshot observation over the AmazMe protocol",
  "dependencies": {
    "@amazme/client": "0.1.0",
    "@amazme/durable": "0.1.0",
    "@amazme/protocol": "0.1.0",
    "@amazme/server": "0.1.0",
    "typebox": "1.3.27"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./src/index.ts" },
    "./client": { "types": "./dist/client.d.ts", "default": "./src/client.ts" },
    "./server": { "types": "./dist/server.d.ts", "default": "./src/server.ts" },
    "./jsonl": { "types": "./dist/jsonl.d.ts", "default": "./src/jsonl.ts" }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
