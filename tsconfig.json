{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@amazme/codemode": [
				"./packages/codemode/src/index.ts"
			],
			"@amazme/codemode/cloudflare": [
				"./packages/codemode/src/cloudflare.ts"
			],
			"@amazme/codemode/portable": [
				"./packages/codemode/src/portable.ts"
			],
			"@amazme/codemode/declarations": [
				"./packages/codemode/src/declarations.ts"
			],
			"@amazme/codemode/source": [
				"./packages/codemode/src/source.ts"
			],
			"@amazme/codemode/worker": [
				"./packages/codemode/src/runtime/worker.ts"
			],
			"@amazme/coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@amazme/coding-agent/config": [
				"./packages/coding-agent/src/config.ts"
			],
			"@amazme/coding-agent/rpc-entry": [
				"./packages/coding-agent/src/rpc-entry.ts"
			],
			"@amazme/coding-agent/update-manifest": [
				"./packages/coding-agent/src/update-manifest.ts"
			],
			"@amazme/web": [
				"./packages/web/dist/index.d.ts"
			],
			"@amazme/web/assets": [
				"./packages/web/src/assets.ts"
			],
			"@amazme/web/locale": [
				"./packages/web/src/locale.ts"
			],
			"@amazme/web/strings": [
				"./packages/web/src/strings.ts"
			],
			"@amazme/web/typography": [
				"./packages/web/src/typography.ts"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@amazme/tui": [
				"./packages/tui/src/index.ts"
			],
			"@amazme/tui/*": [
				"./packages/tui/src/*"
			]
		}
	},
	"files": [],
	"include": [],
	"references": [
		{
			"path": "./tsconfig.node.json"
		},
		{
			"path": "./tsconfig.browser.json"
		}
	],
	"exclude": [
		"**/dist/**"
	]
}
