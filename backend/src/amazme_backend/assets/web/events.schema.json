{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "build_id": {
          "title": "Build Id",
          "type": "string"
        },
        "proposal_digest": {
          "title": "Proposal Digest",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "consumed",
            "expired"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "request_id",
        "run_id",
        "call_id",
        "call",
        "build_id",
        "proposal_digest",
        "revision",
        "state"
      ],
      "title": "Approval",
      "type": "object"
    },
    "CommitBatch": {
      "additionalProperties": false,
      "properties": {
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "string"
        },
        "base_revision": {
          "title": "Base Revision",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "stream_id",
        "seq",
        "base_revision",
        "revision",
        "events"
      ],
      "title": "CommitBatch",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "cancelled",
            "interrupted",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer": {
          "default": "",
          "title": "Answer",
          "type": "string"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EffectHold": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "request_id": {
          "default": "",
          "title": "Request Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "resource_clean": {
          "title": "Resource Clean",
          "type": "boolean"
        },
        "reconciled": {
          "default": false,
          "title": "Reconciled",
          "type": "boolean"
        }
      },
      "required": [
        "call_id",
        "session_id",
        "reason",
        "resource_clean"
      ],
      "title": "EffectHold",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "string"
        },
        "kind": {
          "enum": [
            "accepted",
            "status",
            "preview",
            "message",
            "tool",
            "cleanup",
            "approval",
            "children",
            "effect",
            "freeze",
            "compaction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "seq",
        "kind",
        "request_id",
        "text"
      ],
      "title": "Event",
      "type": "object"
    },
    "Preview": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "generation": {
          "title": "Generation",
          "type": "integer"
        },
        "preview_seq": {
          "title": "Preview Seq",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "run_id",
        "generation",
        "preview_seq",
        "text"
      ],
      "title": "Preview",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting_approval",
            "waiting_children",
            "waiting_time",
            "waiting_host",
            "cancelling",
            "cleaning",
            "blocked",
            "succeeded",
            "cancelled",
            "interrupted",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer": {
          "default": "",
          "title": "Answer",
          "type": "string"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "accepted_revision": {
          "default": "0",
          "title": "Accepted Revision",
          "type": "string"
        },
        "revision": {
          "default": "0",
          "title": "Revision",
          "type": "string"
        },
        "run_id": {
          "default": "",
          "title": "Run Id",
          "type": "string"
        },
        "parent_id": {
          "default": "",
          "title": "Parent Id",
          "type": "string"
        },
        "kind": {
          "default": "root",
          "enum": [
            "root",
            "child",
            "steer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "input_origin": {
          "default": "user",
          "enum": [
            "user",
            "job"
          ],
          "title": "Input Origin",
          "type": "string"
        },
        "generation": {
          "default": 0,
          "title": "Generation",
          "type": "integer"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        },
        "not_before_ms": {
          "default": 0,
          "title": "Not Before Ms",
          "type": "integer"
        },
        "image_count": {
          "default": 0,
          "minimum": 0,
          "title": "Image Count",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "text",
        "status"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "string"
        },
        "state": {
          "enum": [
            "recovering",
            "ready",
            "blocked",
            "stopping",
            "frozen"
          ],
          "title": "State",
          "type": "string"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/Receipt"
          },
          "title": "Requests",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "approvals": {
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "title": "Approvals",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/EffectHold"
          },
          "title": "Effects",
          "type": "array"
        },
        "previews": {
          "items": {
            "$ref": "#/$defs/Preview"
          },
          "title": "Previews",
          "type": "array"
        },
        "next_wake_ms": {
          "default": 0,
          "title": "Next Wake Ms",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "title": "Pending",
          "type": "integer"
        },
        "compaction": {
          "default": "",
          "title": "Compaction",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "stream_id",
        "seq",
        "state",
        "requests",
        "events"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "^(shell|read_file|glob|grep|write_file|edit_file|apply_patch|tool_output|job_list|job_output|job_kill|delegate_task|web_search|web_fetch|mcp_tool|mcp_[a-f0-9]{20}|plugin_tool|plugin_[a-f0-9]{20}|tool_search|codemode)$",
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "title": "Arguments",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "TranscriptMessage": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "type": "string"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "key",
        "ordinal",
        "role",
        "content"
      ],
      "title": "TranscriptMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/CommitBatch"
      },
      "title": "Batches",
      "type": "array"
    },
    "stream_id": {
      "default": "",
      "title": "Stream Id",
      "type": "string"
    },
    "binding_id": {
      "default": "",
      "title": "Binding Id",
      "type": "string"
    },
    "build_id": {
      "default": "",
      "title": "Build Id",
      "type": "string"
    },
    "resync": {
      "default": "",
      "title": "Resync",
      "type": "string"
    }
  },
  "title": "Stream",
  "type": "object"
}
