"""The PyICU word-break API used by tool search; offsets are UTF-16 units."""

from collections.abc import Iterator

class Locale:
    @classmethod
    def getRoot(cls) -> Locale: ...

class UnicodeString:
    def __init__(self, text: str) -> None: ...
    def __getitem__(self, index: slice) -> UnicodeString: ...
    def __str__(self) -> str: ...
    def toLower(self, locale: Locale) -> UnicodeString: ...

class Normalizer2:
    @classmethod
    def getNFCInstance(cls) -> Normalizer2: ...
    def normalize(self, text: str) -> str: ...

class UnicodeSet:
    def __init__(self, pattern: str) -> None: ...
    def freeze(self) -> None: ...
    def contains(self, char: str) -> bool: ...

class BreakIterator:
    @classmethod
    def createWordInstance(cls, locale: Locale) -> BreakIterator: ...
    def setText(self, text: UnicodeString) -> None: ...
    def first(self) -> int: ...
    def __iter__(self) -> Iterator[int]: ...
    def getRuleStatus(self) -> int: ...
