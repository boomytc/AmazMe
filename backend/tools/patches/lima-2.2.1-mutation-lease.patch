+// SPDX-License-Identifier: Apache-2.0
+
+package amazmelease
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func fixture(ctx context.Context, mode string) *exec.Cmd {
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestAmazMeFixture$")
+	for _, entry := range os.Environ() {
+		key, _, _ := strings.Cut(entry, "=")
+		if key != mutationEnv && key != startupEnv && key != probeEnv && key != "AMAZME_TEST_MODE" {
+			cmd.Env = append(cmd.Env, entry)
+		}
+	}
+	cmd.Env = append(cmd.Env, "AMAZME_TEST_MODE=" + mode)
+	return cmd
+}
+
+func line(t *testing.T, reader *bufio.Reader, expected string) {
+	t.Helper()
+	result := make(chan string, 1)
+	go func() { value, _ := reader.ReadString('\n'); result <- strings.TrimSpace(value) }()
+	select {
+	case value := <-result:
+		if value != expected { t.Fatalf("wanted %q, got %q", expected, value) }
+	case <-time.After(10 * time.Second):
+		t.Fatalf("timeout waiting for %q", expected)
+	}
+}
+
+func lockedFile(t *testing.T) *os.File {
+	t.Helper()
+	f, err := os.CreateTemp(t.TempDir(), "operation")
+	if err != nil { t.Fatal(err) }
+	t.Cleanup(func() { f.Close() })
+	if err := unix.Flock(int(f.Fd()), unix.LOCK_EX | unix.LOCK_NB); err != nil { t.Fatal(err) }
+	return f
+}
+
+func lockState(t *testing.T, path string, held bool) {
+	t.Helper()
+	fd, err := unix.Open(path, unix.O_RDWR | unix.O_CLOEXEC, 0)
+	if err != nil { t.Fatal(err) }
+	defer unix.Close(fd)
+	err = unix.Flock(fd, unix.LOCK_EX | unix.LOCK_NB)
+	if held && err != unix.EWOULDBLOCK { t.Fatalf("lease was released early: %v", err) }
+	if !held && err != nil { t.Fatalf("lease leaked after handoff: %v", err) }
+}
+
+func TestAmazMeProtocolProbe(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10 * time.Second)
+	defer cancel()
+	cmd := fixture(ctx, "unexpected")
+	cmd.Env = append(cmd.Env, probeEnv + "=1")
+	output, err := cmd.CombinedOutput()
+	if err != nil || string(output) != Protocol + "\n" { t.Fatalf("probe: %q %v", output, err) }
+}
+
+func TestAmazMeInvalidLeaseFailsBeforeCommand(t *testing.T) {
+	for _, variable := range []string{mutationEnv, startupEnv} {
+		for _, value := range []string{"", "invalid", "0", "2", "999999"} {
+			t.Run(variable + "/" + value, func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 10 * time.Second)
+				defer cancel()
+				cmd := fixture(ctx, "unexpected")
+				cmd.Env = append(cmd.Env, variable + "=" + value)
+				output, err := cmd.CombinedOutput()
+				exit, ok := err.(*exec.ExitError)
+				if !ok || exit.ExitCode() != 125 { t.Fatalf("accepted invalid fd: %q %v", output, err) }
+			})
+		}
+	}
+}
+
+func TestAmazMeConflictingRolesAndNonFileFailClosed(t *testing.T) {
+	for _, conflict := range []bool{false, true} {
+		ctx, cancel := context.WithTimeout(context.Background(), 10 * time.Second)
+		read, write, err := os.Pipe()
+		if err != nil { t.Fatal(err) }
+		cmd := fixture(ctx, "unexpected")
+		cmd.ExtraFiles = []*os.File{read}
+		cmd.Env = append(cmd.Env, mutationEnv + "=3")
+		if conflict { cmd.Env = append(cmd.Env, startupEnv + "=3") }
+		output, err := cmd.CombinedOutput()
+		read.Close(); write.Close(); cancel()
+		exit, ok := err.(*exec.ExitError)
+		if !ok || exit.ExitCode() != 125 { t.Fatalf("accepted invalid lease: %q %v", output, err) }
+	}
+}
+
+func TestAmazMeStartupLeaseSurvivesCLIDeathAndThenReleases(t *testing.T) {
+	for _, finish := range []string{"running", "abort"} {
+		t.Run(finish, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 20 * time.Second)
+			defer cancel()
+			file := lockedFile(t)
+			input, control, err := os.Pipe()
+			if err != nil { t.Fatal(err) }
+			output, writer, err := os.Pipe()
+			if err != nil { t.Fatal(err) }
+			defer input.Close(); defer control.Close(); defer output.Close(); defer writer.Close()
+			cmd := fixture(ctx, "cli")
+			cmd.ExtraFiles = []*os.File{file, input, writer}
+			cmd.Env = append(cmd.Env, mutationEnv + "=3", "AMAZME_TEST_LEASE_PATH=" + file.Name())
+			cmd.Stderr = os.Stderr
+			cliOutput, err := cmd.StdoutPipe()
+			if err != nil { t.Fatal(err) }
+			if err := cmd.Start(); err != nil { t.Fatal(err) }
+			defer cmd.Process.Kill()
+			file.Close(); input.Close(); writer.Close()
+			line(t, bufio.NewReader(cliOutput), "spawned")
+			// Kill the CLI before waiting for any hostagent registration/Running ACK.
+			if err := cmd.Process.Kill(); err != nil { t.Fatal(err) }
+			_ = cmd.Wait()
+			lockState(t, file.Name(), true)
+			haOutput := bufio.NewReader(output)
+			line(t, haOutput, "startup")
+			if _, err := fmt.Fprintln(control, finish); err != nil { t.Fatal(err) }
+			if finish == "running" {
+				line(t, haOutput, "running")
+				lockState(t, file.Name(), false)
+				if _, err := fmt.Fprintln(control, "running"); err != nil { t.Fatal(err) }
+				line(t, haOutput, "running")
+				fmt.Fprintln(control, "exit")
+			}
+			control.Close()
+			drained := make(chan struct{})
+			go func() { io.Copy(io.Discard, haOutput); close(drained) }()
+			select {
+			case <-drained:
+			case <-ctx.Done(): t.Fatal("hostagent fixture did not exit")
+			}
+			lockState(t, file.Name(), false)
+		})
+	}
+}
+
+func TestAmazMeReleaseClosesOnlyStartupDuplicateOnce(t *testing.T) {
+	file := lockedFile(t)
+	fd, err := unix.Dup(int(file.Fd()))
+	if err != nil { t.Fatal(err) }
+	l := &lease{startup: fd}
+	if err := l.running(); err != nil { t.Fatal(err) }
+	lockState(t, file.Name(), true)
+	newFD, err := unix.Open("/dev/null", unix.O_RDONLY | unix.O_CLOEXEC, 0)
+	if err != nil { t.Fatal(err) }
+	if newFD != fd {
+		defer unix.Close(newFD)
+		if err := unix.Dup2(newFD, fd); err != nil { t.Fatal(err) }
+	}
+	defer unix.Close(fd)
+	if err := l.running(); err != nil { t.Fatal(err) }
+	var info unix.Stat_t
+	if err := unix.Fstat(fd, &info); err != nil { t.Fatal("repeated Running closed a reused fd", err) }
+	file.Close()
+	lockState(t, file.Name(), false)
+}
+
+func TestAmazMeFailedChildStartKeepsMutationLease(t *testing.T) {
+	file := lockedFile(t)
+	l := &lease{mutation: file, startup: -1}
+	cmd := exec.Command("/nonexistent-amazme-executable")
+	if err := l.attachStartup(cmd); err != nil { t.Fatal(err) }
+	if err := cmd.Start(); err == nil { t.Fatal("unexpected child") }
+	if err := l.running(); err != nil { t.Fatal(err) }
+	lockState(t, file.Name(), true)
+	if err := (&lease{startup: 99}).attachStartup(cmd); err == nil { t.Fatal("nested hostagent startup accepted") }
+}
+
+// This fixture uses real exec and flock, but never launches Lima or a VM.
+func TestAmazMeFixture(t *testing.T) {
+	mode := os.Getenv("AMAZME_TEST_MODE")
+	if mode == "" { return }
+	if _, exists := os.LookupEnv(mutationEnv); exists { t.Fatal("mutation env leaked") }
+	if _, exists := os.LookupEnv(startupEnv); exists { t.Fatal("startup env leaked") }
+	switch mode {
+	case "cli":
+		for _, fd := range []int{4, 5} { unix.CloseOnExec(fd) }
+		input, output := os.NewFile(4, "startup-input"), os.NewFile(5, "startup-output")
+		child := fixture(context.Background(), "startup")
+		child.Stdin, child.Stdout, child.Stderr = input, output, os.Stderr
+		dummy, err := os.Open("/dev/null")
+		if err != nil { t.Fatal(err) }
+		child.ExtraFiles = []*os.File{dummy} // Verify remapping when ExtraFiles is nonempty.
+		if err := AttachStartup(child); err != nil { t.Fatal(err) }
+		if err := child.Start(); err != nil { t.Fatal(err) }
+		fmt.Println("spawned")
+		for { time.Sleep(time.Hour) }
+	case "startup":
+		fd := processLease.startup
+		flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+		if err != nil || flags & unix.FD_CLOEXEC == 0 { t.Fatalf("startup lease not protected: %v", err) }
+		ctx, cancel := context.WithTimeout(context.Background(), 10 * time.Second)
+		defer cancel()
+		grandchild := fixture(ctx, "inspect")
+		grandchild.Env = append(grandchild.Env, "AMAZME_TEST_CHECK_FD=" + strconv.Itoa(fd))
+		if output, err := grandchild.CombinedOutput(); err != nil { t.Fatalf("descendant inherited lease: %s %v", output, err) }
+		fmt.Println("startup")
+		input := bufio.NewScanner(os.Stdin)
+		for input.Scan() {
+			switch input.Text() {
+			case "running":
+				if err := Running(); err != nil { t.Fatal(err) }
+				fmt.Println("running")
+			case "abort": os.Exit(23)
+			case "exit": return
+			default: t.Fatal("unknown fixture command")
+			}
+		}
+	case "inspect":
+		fd, err := strconv.Atoi(os.Getenv("AMAZME_TEST_CHECK_FD"))
+		if err != nil { t.Fatal(err) }
+		var actual, original unix.Stat_t
+		if err := unix.Stat(os.Getenv("AMAZME_TEST_LEASE_PATH"), &original); err != nil { t.Fatal(err) }
+		if unix.Fstat(fd, &actual) == nil && actual.Dev == original.Dev && actual.Ino == original.Ino {
+			t.Fatal("exec descendant inherited the lease inode")
+		}
+	default: t.Fatal("command ran after invalid lease/probe")
+	}
+}
