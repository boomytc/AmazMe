+// SPDX-License-Identifier: Apache-2.0
+
+// Package amazmelease retains the managed CLI's mutation lease through the
+// hostagent's startup handoff. Ordinary Lima invocations remain unchanged.
+package amazmelease
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+const Protocol = "amazme-mutation-startup/1"
+const mutationEnv = "AMAZME_MUTATION_LEASE_FD"
+const startupEnv = "AMAZME_STARTUP_LEASE_FD"
+const probeEnv = "AMAZME_LEASE_PROTOCOL_PROBE"
+
+type lease struct {
+	mutation *os.File
+	startup int
+	released sync.Once
+	releaseErr error
+}
+
+var processLease *lease
+
+func init() {
+	var err error
+	processLease, err = consumeEnvironment()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(125)
+	}
+	probe := os.Getenv(probeEnv)
+	if err := os.Unsetenv(probeEnv); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(125)
+	}
+	if probe == "1" {
+		fmt.Fprintln(os.Stdout, Protocol)
+		os.Exit(0)
+	}
+}
+
+func consumeEnvironment() (*lease, error) {
+	mutation, hasMutation := os.LookupEnv(mutationEnv)
+	startup, hasStartup := os.LookupEnv(startupEnv)
+	if err := os.Unsetenv(mutationEnv); err != nil {
+		return nil, err
+	}
+	if err := os.Unsetenv(startupEnv); err != nil {
+		return nil, err
+	}
+	if hasMutation && hasStartup {
+		return nil, fmt.Errorf("AmazMe lease has conflicting roles")
+	}
+	l := &lease{startup: -1}
+	if !hasMutation && !hasStartup {
+		return l, nil
+	}
+	value := mutation
+	if hasStartup {
+		value = startup
+	}
+	fd, err := strconv.Atoi(value)
+	if err != nil || fd < 3 {
+		return nil, fmt.Errorf("invalid AmazMe lease descriptor")
+	}
+	var info unix.Stat_t
+	if err := unix.Fstat(fd, &info); err != nil {
+		return nil, err
+	}
+	if info.Mode & unix.S_IFMT != unix.S_IFREG || info.Uid != uint32(os.Geteuid()) {
+		return nil, fmt.Errorf("invalid AmazMe lease file")
+	}
+	flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := unix.FcntlInt(uintptr(fd), unix.F_SETFD, flags | unix.FD_CLOEXEC); err != nil {
+		return nil, err
+	}
+	if hasMutation {
+		// A global reference prevents finalization; only kernel CLI exit closes it.
+		l.mutation = os.NewFile(uintptr(fd), "amazme-mutation-lease")
+	} else {
+		l.startup = fd
+	}
+	return l, nil
+}
+
+// Active identifies the managed path, including after startup handoff.
+func Active() bool {
+	return processLease.mutation != nil || processLease.startup >= 0
+}
+
+// AttachStartup is called before the one permitted background hostagent spawn.
+func AttachStartup(cmd *exec.Cmd) error {
+	return processLease.attachStartup(cmd)
+}
+
+func (l *lease) attachStartup(cmd *exec.Cmd) error {
+	if l.startup >= 0 {
+		return fmt.Errorf("AmazMe hostagent cannot launch another instance")
+	}
+	if l.mutation == nil {
+		return nil
+	}
+	fd := 3 + len(cmd.ExtraFiles)
+	env := make([]string, 0, len(cmd.Environ()) + 1)
+	for _, entry := range cmd.Environ() {
+		key, _, _ := strings.Cut(entry, "=")
+		if key != mutationEnv && key != startupEnv && key != probeEnv {
+			env = append(env, entry)
+		}
+	}
+	cmd.Env = append(env, startupEnv + "=" + strconv.Itoa(fd))
+	cmd.ExtraFiles = append(cmd.ExtraFiles, l.mutation)
+	return nil
+}
+
+// Running releases only the hostagent's startup duplicate, after its VM has
+// started and its registered control path owns all further stop/exit behavior.
+func Running() error {
+	return processLease.running()
+}
+
+func (l *lease) running() error {
+	if l.startup < 0 {
+		return nil
+	}
+	l.released.Do(func() {
+		// LOCK_UN would also revoke the CLI's shared open-file-description lock.
+		l.releaseErr = unix.Close(l.startup)
+	})
+	return l.releaseErr
+}
