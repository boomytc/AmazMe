+//go:build !darwin
+
+// SPDX-License-Identifier: Apache-2.0
+
+package amazmelease
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+)
+
+func init() {
+	for _, key := range []string{"AMAZME_MUTATION_LEASE_FD", "AMAZME_STARTUP_LEASE_FD", "AMAZME_LEASE_PROTOCOL_PROBE"} {
+		if _, present := os.LookupEnv(key); present {
+			fmt.Fprintln(os.Stderr, "AmazMe managed mutation leases require Darwin")
+			os.Exit(125)
+		}
+	}
+}
+
+func Active() bool { return false }
+func AttachStartup(_ *exec.Cmd) error { return nil }
+func Running() error { return nil }
