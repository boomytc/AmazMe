{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/auth": {
      "post": {
        "summary": "Login",
        "operationId": "login_auth_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Login Auth Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap": {
      "get": {
        "summary": "Bootstrap",
        "operationId": "bootstrap_api_v1_bootstrap_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "summary": "Sessions",
        "operationId": "sessions_api_v1_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create",
        "operationId": "create_api_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/snapshot": {
      "get": {
        "summary": "Snapshot",
        "operationId": "snapshot_api_v1_sessions__session__snapshot_get",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/submissions": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_api_v1_sessions__session__submissions_post",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submit"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/requests/{request_id}": {
      "get": {
        "summary": "Lookup",
        "operationId": "lookup_api_v1_sessions__session__requests__request_id__get",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session"
            }
          },
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/requests/{request_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "operationId": "cancel_api_v1_sessions__session__requests__request_id__cancel_post",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session"
            }
          },
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/control/shutdown": {
      "post": {
        "summary": "Shutdown",
        "operationId": "shutdown_control_shutdown_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HostFence"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSession": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "default": "\u65b0\u4f1a\u8bdd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateSession"
      },
      "Event": {
        "properties": {
          "seq": {
            "type": "string",
            "title": "Seq"
          },
          "kind": {
            "type": "string",
            "enum": [
              "accepted",
              "status",
              "preview",
              "message",
              "tool",
              "cleanup"
            ],
            "title": "Kind"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seq",
          "kind",
          "request_id",
          "text"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HostFence": {
        "properties": {
          "host_epoch": {
            "type": "integer",
            "title": "Host Epoch"
          },
          "build_id": {
            "type": "string",
            "title": "Build Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "host_epoch",
          "build_id"
        ],
        "title": "HostFence"
      },
      "Identity": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "protocol": {
            "type": "string",
            "title": "Protocol",
            "default": "amazme-http/1"
          },
          "build_id": {
            "type": "string",
            "title": "Build Id"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "pid": {
            "type": "integer",
            "title": "Pid"
          },
          "host_epoch": {
            "type": "integer",
            "title": "Host Epoch",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "build_id",
          "profile_id",
          "instance_id",
          "pid"
        ],
        "title": "Identity"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Login"
      },
      "Receipt": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "cancelled",
              "interrupted",
              "failed",
              "unknown"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "default": ""
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          },
          "accepted_revision": {
            "type": "string",
            "title": "Accepted Revision",
            "default": "0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text",
          "status"
        ],
        "title": "Receipt"
      },
      "Session": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "title"
        ],
        "title": "Session"
      },
      "SessionList": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array",
            "title": "Sessions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sessions"
        ],
        "title": "SessionList"
      },
      "Snapshot": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "stream_id": {
            "type": "string",
            "title": "Stream Id"
          },
          "seq": {
            "type": "string",
            "title": "Seq"
          },
          "state": {
            "type": "string",
            "enum": [
              "recovering",
              "ready",
              "blocked",
              "stopping"
            ],
            "title": "State"
          },
          "requests": {
            "items": {
              "$ref": "#/components/schemas/Receipt"
            },
            "type": "array",
            "title": "Requests"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "stream_id",
          "seq",
          "state",
          "requests",
          "events"
        ],
        "title": "Snapshot"
      },
      "Submit": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text"
        ],
        "title": "Submit"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
