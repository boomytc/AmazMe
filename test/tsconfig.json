{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["*.test.ts"],
  "references": [
    { "path": "../packages/ai" },
    { "path": "../packages/agent" },
    { "path": "../packages/durable" },
    { "path": "../packages/telemetry" }
  ]
}
